# Application
APP_ENV=prod
APP_DEBUG=0
APP_NAME="Semitexa App"
APP_KEY=semitexa-local-dev-key

# Swoole server
# Starter app URL: http://localhost:9502 (update this if you change SWOOLE_PORT)
#
# SWOOLE_PORT is reconciled on every `bin/semitexa server:start` against the
# shared local router (default range 9501-9599). If it collides with another
# local Semitexa app or is bound by another host process, the broker rewrites
# SWOOLE_PORT in your project-local .env to the next free port. To pin a
# specific port, set SWOOLE_PORT in .env (not here); the broker will accept
# it when available and otherwise log a warning and pick a safe alternative.
SWOOLE_HOST=0.0.0.0
SWOOLE_PORT=9502
SWOOLE_WORKER_NUM=4
SWOOLE_MAX_REQUEST=10000
SWOOLE_MAX_COROUTINE=100000
SWOOLE_LOG_FILE=var/log/swoole.log
SWOOLE_LOG_LEVEL=1
# Log rotation. Preferred named values: single|monthly|daily|hourly|every-minute.
# Swoole's own numeric form (0-4) and 'off' are accepted as aliases.
# Anything but 'single' makes Swoole write to <SWOOLE_LOG_FILE>.<date> and
# leave the configured file empty; `semitexa logs:app --file=swoole` follows it.
SWOOLE_LOG_ROTATION=daily
# Rotated logs older than this are deleted at server start; 0 disables the
# sweep entirely. The live log is never deleted in either case, and neither
# are rotated files another tool produced (only Swoole's own <date> suffix).
SWOOLE_LOG_RETENTION_DAYS=14
# Swoole tracer (>= 6.2): report internal calls that block a coroutine longer
# than SWOOLE_BLOCKING_THRESHOLD µs with a backtrace on stdout. Diagnostic
# tool — enable per-session in .env, not permanently (worker overhead).
SWOOLE_BLOCKING_DETECTION=Off
SWOOLE_BLOCKING_THRESHOLD=100000

# PHP memory limit for the long-lived Swoole worker. Unlike a request-per-process
# SAPI, one worker holds every open SSE session, its queues and its subscription
# state for its whole life, so PHP's 128M default is too tight: the worker dies
# with exit 255 under load and every route it served starts timing out, including
# ones unrelated to SSE.
#
# This value is the baseline: bin/semitexa merges .env.default with .env and
# exports the result before invoking Compose, so the setting below takes effect
# on the normal path. Put machine-specific overrides in .env, which wins. Note
# that a bare `docker compose` invocation reads only .env, so the fallback in
# docker-compose.yml is what applies there.
PHP_MEMORY_LIMIT=512M

# Swoole shared memory tables (allocated upfront: rows × max_bytes)
# Increase for high-load or large session payloads.
# SWOOLE_SESSION_TABLE_SIZE=4096
# SWOOLE_SESSION_MAX_BYTES=65535
# SWOOLE_SSE_WORKER_TABLE_SIZE=4096
# SWOOLE_SSE_DELIVER_TABLE_SIZE=8192
# SWOOLE_SSE_PAYLOAD_MAX_BYTES=65535

# Session (Swoole Table). Cookie name and lifetime in seconds.
# SESSION_COOKIE_NAME=semitexa_session
# SESSION_LIFETIME=3600

# Database
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=semitexa
DB_USERNAME=semitexa
DB_PASSWORD=semitexa
DB_ROOT_PASSWORD=semitexa-root
DB_POOL_SIZE=10
DB_CHARSET=utf8mb4

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Events: 1 = NATS/JetStream (use with Docker), 0 = in-memory
EVENTS_ASYNC=1
NATS_PRIMARY_URL=nats://nats:4222

# CORS
CORS_ALLOW_ORIGIN=*
CORS_ALLOW_METHODS=GET, POST, PUT, DELETE, OPTIONS
CORS_ALLOW_HEADERS=Content-Type, Authorization
CORS_ALLOW_CREDENTIALS=false

# Enable the starter project's deferred SSR demo out of the box.
SSR_ISOMORPHIC_ENABLED=true
# Keep the Hello starter cards visibly deferred so the fresh install clearly
# demonstrates Semitexa's KISS streaming path.
HELLO_DEMO_DELAY=1
# Keep the demo deferred page visibly staggered so slot arrivals are easy to inspect.
DEMO_DEFERRED_DELAY=1

# Persistent deferred SSE is optional. Enable it explicitly if authorized users
# should reuse the same connection for ongoing runtime features after initial delivery.
SSR_DEFERRED_PERSISTENT_SSE=false
SSR_DEFERRED_PERSISTENT_SSE_REQUIRE_AUTH=true

# Optional crawler hints for the auto-generated robots.txt fallback.
# ROBOTS_SITEMAP_URL=https://example.com/sitemap.xml
# ROBOTS_HOST=example.com
# AI_SITEMAP_URL=https://example.com/sitemap.json

# LLM (Ollama)
# Available models: gemma3:4b, gemma3:12b, llama3.2:3b, llama3.2:8b, mistral:7b, phi4:14b
# After starting, pull a model: docker compose exec ollama ollama pull gemma3:4b
# LLM configuration is optional. Uncomment the following lines to enable Ollama.
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434
# LLM_MODEL=gemma3:4b
# LLM_TIMEOUT=60
