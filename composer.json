{
    "name": "semitexa/update",
    "description": "Semitexa Update \u2014 update lifecycle: package version detection, framework auto-deploy, remote bootstrap, and post-schema data patches",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.10.31.0849 || dev-master",
        "semitexa/installer": ">=2026.11.19.1455 || dev-master",
        "semitexa/orm": ">=2026.11.14.1040 || dev-master",
        "symfony/console": "^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Update\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Update\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "extends": null
        },
        "semitexa": {
            "floors": {
                "semitexa/orm": "2026.11.14.1040",
                "semitexa/core": "next",
                "semitexa/installer": "2026.11.19.1455"
            }
        }
    },
    "keywords": [
        "semitexa",
        "update",
        "data-patches",
        "framework-update",
        "platform"
    ]
}
